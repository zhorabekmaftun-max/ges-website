[Unit]
Description=GES Website (static Python server)
After=network.target

[Service]
Type=simple
# Измените путь и пользователя под свой сервер
WorkingDirectory=/var/www/ges-website
ExecStart=/usr/bin/python3 /var/www/ges-website/server.py --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
User=www-data
Group=www-data
Environment=PORT=8000

# Базовая изоляция
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
